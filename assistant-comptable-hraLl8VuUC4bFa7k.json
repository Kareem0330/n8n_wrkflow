        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"nom_item\":       { \"type\": [\"string\", \"null\"], \"description\": \"Nom de la société qui émet la facture\" },\n    \"numero_facture\": { \"type\": [\"string\", \"null\"], \"description\": \"Valeur après « numéro: », « N° » ou « Id ». null si absente\" },\n    \"date_facture\":   { \"type\": [\"string\", \"null\"], \"description\": \"Date d'émission au format AAAA-MM-JJ\" },\n    \"montant_total\":  { \"type\": [\"number\", \"null\"], \"description\": \"Montant total TTC\" },\n    \"montant_tva\":    { \"type\": [\"number\", \"null\"], \"description\": \"Montant de la TVA\" },\n    \"devise\":         { \"type\": [\"string\", \"null\"], \"description\": \"Code devise ISO, ex. EUR\" }\n  },\n  \"required\": [\"nom_item\", \"numero_facture\", \"date_facture\", \"montant_total\", \"montant_tva\", \"devise\"]\n}"
